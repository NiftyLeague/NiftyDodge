  m_Script: {fileID: 11500000, guid: 6bf962c4e99201947a6aa82a5323977e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gameplayManager: {fileID: 203195491}
  audioManager: {fileID: 201607129}
  pengweevilController: {fileID: 1453282007}
  waveScreenManager: {fileID: 287079799}
  dialogueBox: {fileID: 222251443}
  offScreenAnchorY: 60
  onScreenAnchorY: 41
  faceBoxAnimation1: {fileID: 1945328033}
  faceBoxImage1: {fileID: 1945328031}
  faceDefaultSprite1: {fileID: 21300000, guid: c38d3d52430a9e549b12ae41b7885bca, type: 3}
  faceBoxAnimation2: {fileID: 502320480}
  faceBoxImage2: {fileID: 502320478}
  faceDefaultSprite2: {fileID: 21300000, guid: ad6ee43b172c79545bf4874fbd5f414f, type: 3}
  skipDialogueButtonPrompt: {fileID: 1886239797}
  dialogueText: {fileID: 247996855}
  endOfGameDialogueText: {fileID: 29441856}
  textTypeSpeed: 30
  timeBetweenNextText: 2
  dialogueSetList:
  - speechString:
    - "Look here, Peng! Another hapless victim aka would-be hero who\u2019s trying
      to stop us from perpetuating our CRYPTO WINTER!"
    - "Let\u2019s get \u2018em! Start the launchers!"
  - speechString:
    - "It\u2019s time for a perpetual CRYPTO WINTER! Hope you\u2019ve dressed warmly!"
    - "I\u2019m cold and I wanna go home."
    - "You\u2019re a penguin! You like the cold!"
  - speechString:
    - "As long as it\u2019s CRYPTO WINTER, I PENGWEEVIL can sweep all the floors!"
    - You could start by sweeping your room.
    - "I\u2019ll make YOU sweep my room!"
  - speechString:
    - 'I like my coffee like I like my crypto: DOWN'
    - "That doesn\u2019t even make sense."
  - speechString:
    - "Time to kick butt and chew bubble-gum\u2026 and I\u2019m all out of gas."
    - Again, makes no sense.
  - speechString:
    - If I freeze all the DEGENS, The Niftyverse is MINE!
    - "Satoshi gonna doubleb\xF6nk you fam."
  - speechString:
    - This particular DEGEN is feisty, PENG!
    - Feisty AND frosty, WEEVIL!
  - speechString:
    - "I sure hope Seiya doesn\u2019t come this way."
    - "Even we\u2019re terrified of him."
    - "Let\u2019s get out of here."
  - speechString:
    - PENG! I thought you said these snowball launchers were supposed to be effective!
    - They are, WEEVIL! I bought them from RugMan!
  bonusDialogue:
    speechString:
    - You must be tired from all that dodging around, how about we reward you with
      some delicious treats?
    - Wait why are we helping them?
  bossFightBeginDialogue:
    speechString:
    - <color=red>Beatdown!
    - Beatdown?
  bossDefeatedDialogue:
    speechString:
    - PENGWEEVIL careened through the air and crashed headfirst into his Igloo Palace!
    - The resulting explosion launched an impressive fireball high into the sky that
      dispersed the snowy clouds.
    - "The Sun peeked through the clouds, snow began to melt and life returned to
      Satoshi\u2019s Domain once more!"
    - "CONGRATULATIONS! You're a hero for defeating PENGWEEVIL\u2019S CRYPTO WINTER!\r\nHowever,
      you may have won the battle but not the war\u2026"
    - "PENGWEEVIL survived the aftermath. PENG cursed the DEGENs and made it clear
      that once he\u2019s rebuilt his Igloo Palace, he\u2019ll be back - and next
      time he\u2019ll be STRONGER! \r\n(WEEVIL was just glad to be warm again)"
    - <i>Would you like to continue and try to increase your score further?
  bossDefeatedSlides:
  - {fileID: 21300000, guid: 61866461da2e4994da0ff8a0b391c7e7, type: 3}
  - {fileID: 21300000, guid: 946829d64d5fbbc45b572b0d96d0bb85, type: 3}
  - {fileID: 21300000, guid: 3bd1df1fbf8a7f243b03c0eef4c91819, type: 3}
  - {fileID: 21300000, guid: a2f2783da27ecfb4e9ffee8c72eb352e, type: 3}
  - {fileID: 21300000, guid: 1810a89851ba4f74bb47663b7baf4e6d, type: 3}
  - {fileID: 21300000, guid: 1810a89851ba4f74bb47663b7baf4e6d, type: 3}
  EndOfGameBackgroundSpriteRenderer: {fileID: 874627934}
  EndOfGameBackgroundSlideSpriteRenderer: {fileID: 1357561150}
  endGameCanvasMenu: {fileID: 487515444}
  endGameButtonPrompt: {fileID: 1546015827}
